// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  member
}

enum UserStatus {
  active
  inactive
  banned
}

enum LinkStatus {
  active
  inactive
  deleted
}

enum AdType {
  none       // 0 - Direct
  interstitial // 1
  banner     // 2
  random     // 3 - Randomly interstitial or banner
  popup      // 4
}

enum CampaignStatus {
  pending
  active
  paused
  completed
  rejected
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

enum InvoiceStatus {
  pending
  paid
  failed
  refunded
}

enum PageStatus {
  published
  draft
}

enum PostStatus {
  draft
  published
  scheduled
  trashed
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId      String?          @unique
  username         String           @unique
  email            String           @unique
  emailVerified    DateTime?
  apiToken         String?          @default(cuid())
  role             UserRole         @default(member)
  status           UserStatus       @default(active)
  balance          Float            @default(0)
  totalEarned      Float            @default(0)
  referralEarnings Float            @default(0)
  referredCount    Int              @default(0)
  referralId       String?          @db.ObjectId
  disableEarnings  Boolean          @default(false)
  avatar           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Profile Information
  firstName        String?
  lastName         String?
  address1         String?
  address2         String?
  city             String?
  state            String?
  zip              String?
  country          String?
  withdrawalMethod  String?
  withdrawalAccount String?

  links            Link[]
  statistics       Statistic[]
  campaigns        Campaign[]
  withdrawals      Withdrawal[]
  invoices         Invoice[]
  tickets          Ticket[]
  userPlan         UserPlan?
  payments         Payment[]
  posts            Post[]           @relation("UserPosts")
  referrer User? @relation("Referrals", fields: [referralId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals        User[]           @relation("Referrals")
}

model Link {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  url         String
  alias       String     @unique
  title       String?
  description String?
  adType      Int        @default(1) // 0=direct,1=interstitial,2=banner,3=random
  status      Int        @default(1) // 1=active,2=inactive,3=deleted
  hits        Int        @default(0)
  expiration  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  statistics  Statistic[]

  
  @@index([userId])
}

model Statistic {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  linkId String @db.ObjectId
  userId String @db.ObjectId
  ip               String
  country          String   @default("Others")
  device           Int      @default(2) // 1=all,2=desktop,3=mobile
  adType           Int      @default(1)
  reason           Int      @default(1) // see earnings engine
  advertiserPrice  Float    @default(0)
  publisherPrice   Float    @default(0)
  campaignId String? @db.ObjectId
  campaignUserId String? @db.ObjectId
  campaignItemId String? @db.ObjectId
  refererUrl       String?
  createdAt        DateTime @default(now())

  link             Link     @relation(fields: [linkId], references: [id])
  user             User     @relation(fields: [userId], references: [id])

  @@index([linkId])
  @@index([userId])
  @@index([createdAt])
  @@index([country])
  @@index([userId, ip, reason, createdAt]) // Compound: unique visit check in calcEarnings()
  @@index([ip, createdAt]) // Compound: rate-limiting & analytics
}

model Campaign {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  name             String
  websiteUrl       String
  adType           Int            @default(1) // 1=interstitial,2=banner,3=popup
  bannerSize       String?        // "728x90","468x60","336x280"
  bannerCode       String?
  budget           Float          @default(0)
  spent            Float          @default(0)
  trafficSource    Int            @default(1) // 1=all,2=desktop,3=mobile
  defaultCampaign  Boolean        @default(false)
  status           Int            @default(0) // 0=pending,1=active,2=paused,3=completed,4=rejected
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id])
  campaignItems    CampaignItem[]
}

model CampaignItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String @db.ObjectId
  country         String   @default("all")
  weight          Float    @default(0) // 0-100 percentage fill
  advertiserPrice Float    @default(0)
  publisherPrice  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign        Campaign @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

model Plan {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  price                 Float      @default(0)
  linksLimit            Int        @default(-1) // -1 = unlimited
  viewsHourlyLimit      Int        @default(0)  // 0 = unlimited
  viewsDailyLimit       Int        @default(0)
  viewsMonthlyLimit     Int        @default(0)
  linkExpiration        Boolean    @default(false)
  direct                Boolean    @default(false)
  disableAds            Boolean    @default(false)
  disableCaptcha        Boolean    @default(false)
  onetimeCaptcha        Boolean    @default(false)
  visitorsRemoveCaptcha Boolean    @default(false)
  timer                 Int        @default(5)
  isDefault             Boolean    @default(false)
  features              String?    // JSON array of feature strings
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  userPlans             UserPlan[]
}

model UserPlan {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId       @unique
  planId String @db.ObjectId
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])
}

model Withdrawal {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  amount         Float
  method         String           @default("paypal") // paypal, bank, crypto
  accountDetails String
  status         Int              @default(0) // 0=pending,1=approved,2=rejected
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id])
}

model Invoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  amount    Float
  method    String   @default("razorpay")
  status    Int      @default(0) // 0=pending,1=paid,2=failed,3=refunded
  meta      String?  // JSON metadata (txn id, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  payments  Payment[]
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  invoiceId String? @db.ObjectId
  razorpayOrderId String @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount Float
  currency String @default("INR")
  status String @default("created")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([userId])
  @@index([invoiceId])
}

model Page {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  content     String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Posts / Blog CMS ───

model PostCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model PostTag {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  postCount Int      @default(0)
  createdAt DateTime @default(now())
}

model Post {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  slug        String     @unique
  title       String
  excerpt     String?
  content     String     // HTML from WYSIWYG editor
  image       String?    // Featured image URL
  status      PostStatus @default(draft)
  authorId    String?    @db.ObjectId
  authorName  String?    // Denormalized author display name
  categoryId  String?    @db.ObjectId
  tags        String[]   // Array of tag names (denormalized for easy querying)
  metaTitle   String?    // SEO meta title
  metaDesc    String?    // SEO meta description
  focusKw     String?    // SEO focus keyword
  views       Int        @default(0)
  wordCount   Int        @default(0)
  readingTime Int        @default(0) // estimated reading time in minutes
  featured    Boolean    @default(false)
  allowComments Boolean  @default(true)
  scheduledAt DateTime?  // for scheduled posts
  publishedAt DateTime?
  trashedAt   DateTime?
  customTheme String?    // Custom HTML theme template
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   User?         @relation("UserPosts", fields: [authorId], references: [id])
  category PostCategory? @relation(fields: [categoryId], references: [id])

  @@index([authorId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([status, publishedAt]) // Compound: blog listing sorted by publish date
  @@index([status, views]) // Compound: trending/popular posts query
}

// ─── End Posts / Blog CMS ───

model Testimonial {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  avatar    String?
  text      String
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  type      String   @default("info") // info, warning, success
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
}

model Ticket {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  subject   String
  status    Int      @default(0) // 0=Open, 1=Answered, 2=Closed
  priority  Int      @default(0) // 0=Low, 1=Medium, 2=High
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  replies   TicketReply[]

  @@index([userId])
}

model TicketReply {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  ticketId String @db.ObjectId
  userId String @db.ObjectId
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  key         String   @unique // e.g. "paypal", "bitcoin"
  type        String   @default("deposit") // "deposit" or "withdrawal" or "both"
  details     String?  // HTML/Instructions for the user
  inputLabel  String?  // Label for the user input (e.g. "PayPal Email")
  minAmount   Float    @default(5)
  maxAmount   Float    @default(1000)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
